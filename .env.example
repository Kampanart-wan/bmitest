DATABASE_URL=postgres://bmi:bmi@localhost:5434/bmi

# Google AI (Gemini) — ใส่ API key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (ไม่บังคับ) เปลี่ยนรุ่นโมเดลได้ ค่าเริ่มต้นคือ gemini-flash-lite-latest (เร็ว) ถ้าโมเดลนี้ไม่ว่างจะสลับไป gemini-flash-latest อัตโนมัติ
# GEMINI_MODEL=gemini-flash-lite-latest
